<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pancy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sfondo_avvio</item>
    </style>

    <!-- Schermata di avvio: mostra l'icona, poi l'app passa al tema normale (Theme.Pancy) -->
    <style name="Theme.Pancy.Avvio" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/sfondo_avvio</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/sfondo_icona</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pancy</item>
    </style>
</resources>
